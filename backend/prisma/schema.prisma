generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model User {
  // Primary Key
  id              String   @id @default(uuid())

  // Authentication
  email           String   @unique
  password        String                                                                                                                    

  // Profile
  fullName        String
  avatar          String?

  // Account Status
  isEmailVerified Boolean  @default(false)
  isActive        Boolean  @default(true)

  // Preferences
  theme           Theme    @default(SYSTEM)

  // Location
  country         String?
  city            String?
  timezone        String?

  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}